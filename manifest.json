{
  "manifest_version": 3,
  "name": "No Add Extension",
  "description": "Prototype qui détecte et saute en direct les segments de collaboration commerciale sur YouTube.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "No Add Extension"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/mseInterceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "libs/mp4demux.js",
        "content/config.js",
        "content/util.js",
        "content/segments.js",
        "content/ui.js",
        "content/sandbox.js",
        "content/overlay.js",
        "content/ocr.js",
        "content/mse-buffer.js",
        "content/decoder.js",
        "content/probe.js",
        "content/scanner.js",
        "content/skip.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/ocr-sandbox.html",
        "pages/ocr-sandbox.js",
        "pages/decoder-sandbox.html",
        "pages/decoder-sandbox.js",
        "libs/tesseract/*",
        "libs/mp4demux.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
